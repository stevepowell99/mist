# Copy to `.dev.vars` (gitignored) for `npm run dev`. Local dev runs the Worker
# and Durable Objects in workerd on your machine, so it does NOT use the
# Cloudflare account's DO duration: use it for solo work to stay off the free
# tier cap. Fill the GOOGLE_* values with the same values set in production via
# `wrangler secret put` (Cloudflare secrets are write-only; reuse the originals).

# Drive relay identity: server-side OAuth client (Google Cloud > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Public web client id for Google sign-in. Add http://localhost:5173 to this
# client's Authorized JavaScript origins, or local sign-in is rejected.
GOOGLE_SIGNIN_CLIENT_ID=

# HMAC secret for the session cookie. Any random string; local-only.
SESSION_SECRET=

# Fathom analytics (optional, omit to disable).
VITE_FATHOM_SITE_ID=
VITE_FATHOM_DOMAINS=

# Local-fs mode (optional, dev only): edit this machine's own files instead of
# Google Drive; no Google secrets, sign-in or internet needed (SESSION_SECRET
# is still required). Start with `npm run dev:local`, which runs the localfs
# sidecar and the dev server together. Production never sets these, so the
# deployed worker is Drive-only.
#
# There is no folder to configure and no search: any file on the machine is
# reachable by path, and TagFox (its "Open in gmist" row button) is how you
# open one. LOCAL_FS_TOKEN is the ONLY access control on the sidecar (loopback
# bind is not enough: a web page you visit could otherwise POST to it). Use any
# long random string, e.g. `node -e "console.log(crypto.randomUUID())"`.
LOCAL_FS_URL=http://127.0.0.1:5199
LOCAL_FS_TOKEN=
